def arithmetic_sequence():
    print()
    print("========== ARITHMETIC SEQUENCE ==========")

    a1 = float(input("Enter first term (a1): "))
    d = float(input("Enter common difference (d): "))
    n = int(input("Find term (n): "))

    an = a1 + (n - 1) * d

    print()
    print("Calculation:")
    print("Formula: aₙ = a₁ + (n - 1)d")
    print(f"aₙ = {a1} + ({n} - 1)({d})")
    print(f"aₙ = {an}")

    print()
    print(f"Answer: a_{n} = {an}")


def geometric_sequence():
    print()
    print("========== GEOMETRIC SEQUENCE ==========")

    a1 = float(input("Enter first term (a1): "))
    r = float(input("Enter common ratio (r): "))
    n = int(input("Find term (n): "))

    an = a1 * (r ** (n - 1))

    print()
    print("Calculation:")
    print("Formula: aₙ = a₁rⁿ⁻¹")
    print(f"aₙ = {a1}({r})^({n}-1)")
    print(f"aₙ = {an}")

    print()
    print(f"Answer: a_{n} = {an}")


def explicit_sequence():
    print()
    print("========== EXPLICIT SEQUENCE ==========")

    print("Example:")
    print("aₙ = 3n")
    print("aₙ = 4n² - 2n + 1")
    print()

    from sympy import symbols, sympify

    n = symbols("n")

    formula = input("Enter aₙ in terms of n: ")
    target = int(input("Find term (n): "))

    try:
        expression = sympify(formula)
        result = expression.subs(n, target)

        print()
        print("Calculation:")
        print(f"aₙ = {expression}")
        print(f"a_{target} = {expression.subs(n, target)}")
        print(f"a_{target} = {result}")

        print()
        print(f"Answer: a_{target} = {result}")

    except Exception:
        print()
        print("Invalid expression.")
        print("Example: 3*n or 4*n**2 - 2*n + 1")


def recursive_sequence():
    print()
    print("========== RECURSIVE SEQUENCE ==========")

    a1 = float(input("Enter a₁: "))
    formula = input("Enter recurrence for aₙ₊₁ (use n and a): ")
    target = int(input("Find term (n): "))

    if target < 1:
        print("n must be greater than or equal to 1.")
        return

    current = a1

    print()
    print("Given:")
    print(f"a₁ = {a1}")
    print(f"aₙ₊₁ = {formula}")

    if target == 1:
        print()
        print(f"Answer: a₁ = {current}")
        return

    print()
    print("Calculation:")

    for n in range(1, target):
        try:
            next_term = eval(
                formula,
                {"__builtins__": {}},
                {
                    "n": n,
                    "a": current
                }
            )

            print(f"a_{n + 1} = {formula}")
            print(f"     = {next_term}")
            print()

            current = next_term

        except Exception:
            print("Invalid recurrence.")
            print("Example: 3*a + 5")
            return

    print(f"Answer: a_{target} = {current}")


def sequences_menu():

    while True:

        print()
        print("========================================")
        print("             SEQUENCES")
        print("========================================")

        print("1. Arithmetic Sequence")
        print("2. Geometric Sequence")
        print("3. Explicit Sequence")
        print("4. Recursive Sequence")
        print("0. Back")

        print()

        choice = input("Select: ")

        if choice == "1":
            arithmetic_sequence()

        elif choice == "2":
            geometric_sequence()

        elif choice == "3":
            explicit_sequence()

        elif choice == "4":
            recursive_sequence()

        elif choice == "0":
            break

        else:
            print("Invalid selection.")